# This file contains the environment variables needed for the backend.
# Copy this file to .env and fill in the values.

# The secret key used for signing JWTs.
# You can generate a new one with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here

# The database URL.
# For SQLite (default): DATABASE_URL=sqlite:///./predictive_maintenance.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:port/dbname
# For MySQL: DATABASE_URL=mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./predictive_maintenance.db
